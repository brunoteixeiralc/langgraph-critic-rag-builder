OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=
# Required by src/server.ts (the HTTP wrapper used for deployment, e.g. Railway).
# Sent as the "x-api-key" header by callers of POST /generate. If unset, the
# endpoint is left unprotected — fine for local dev, not for a public deploy.
SERVER_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# LangSmith tracing (optional) — powers the trace view + `npm run eval`.
# Get a key at smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Without this, each traced call blocks briefly waiting for its trace to
# finish uploading to LangSmith before returning — that's the
# "Using a background run tree..." warning you'll otherwise see on every
# run. Flips tracing uploads to a background queue so they don't add to
# request latency. Only relevant when LANGSMITH_TRACING=true.
LANGCHAIN_CALLBACKS_BACKGROUND=true
GEMINI_API_KEY=
# Must be a Gemini *embedding* model (used by RagService for Pinecone vectors)
GEMINI_MODEL=models/gemini-embedding-001